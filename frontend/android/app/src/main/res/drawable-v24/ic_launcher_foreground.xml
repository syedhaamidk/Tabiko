<?xml version="1.0" encoding="utf-8"?>
<!-- Tabiko launcher foreground: the BrandMark inner geometry, drawn from the
     same 64-unit design space as BrandMark.jsx and the PWA painter (group
     scale 108/64 = 1.6875), so the store icon, the splash, and the in-app
     mark cannot drift apart. The outer pink square is the background
     drawable; only the inner mark lives here. Strokes scale with the group,
     which is why they read slightly chunkier than in-app — correct for an
     icon viewed at 48dp. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="1.6875"
        android:scaleY="1.6875">
        <path
            android:fillColor="#FFD23F"
            android:strokeColor="#2A0E1E"
            android:strokeWidth="3"
            android:strokeLineJoin="round"
            android:pathData="M13,33 a19,19 0 1,0 38,0 a19,19 0 1,0 -38,0Z" />
        <path
            android:fillColor="#2D5BFF"
            android:strokeColor="#2A0E1E"
            android:strokeWidth="2.5"
            android:strokeLineJoin="round"
            android:pathData="M21,33 a11,11 0 1,0 22,0 a11,11 0 1,0 -22,0Z" />
        <path
            android:fillColor="#FFFFFF"
            android:strokeColor="#2A0E1E"
            android:strokeWidth="2.5"
            android:strokeLineJoin="round"
            android:pathData="M32,16 c5,7 10,11 10,18 c0,7 -5,12 -10,12 c-5,0 -10,-5 -10,-12 c0,-7 5,-11 10,-18Z" />
        <path
            android:fillColor="#FF6B35"
            android:pathData="M32,30 c3,4 5,6 5,10 c0,3 -2,5 -5,5 c-3,0 -5,-2 -5,-5 c0,-4 2,-6 5,-10Z" />
        <path
            android:fillColor="#C6F135"
            android:strokeColor="#2A0E1E"
            android:strokeWidth="1.5"
            android:strokeLineJoin="round"
            android:pathData="M9,12 l2,5 5,2 -5,2 -2,5 -2,-5 -5,-2 5,-2 2,-5Z" />
        <path
            android:fillColor="#C6F135"
            android:strokeColor="#2A0E1E"
            android:strokeWidth="1.5"
            android:strokeLineJoin="round"
            android:pathData="M53,40 l1.5,4 4,1.5 -4,1.5 -1.5,4 -1.5,-4 -4,-1.5 4,-1.5 1.5,-4Z" />
    </group>
</vector>
