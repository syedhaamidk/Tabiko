# Tabiko backend configuration
#
# Copy to `.env` and fill in real values. `.env` is gitignored — never commit keys.
# This file is only a template; every variable has a working default.

# --- Core -------------------------------------------------------------------

# PostgreSQL or SQLite. Defaults to the local SQLite file at backend/tabiko.db.
# TABIKO_DATABASE_URL=postgresql+psycopg://tabiko:secret@localhost:5432/tabiko

# Comma-separated origins allowed to call the API. Defaults to localhost:5173
# and localhost:8000 during development.
# TABIKO_CORS_ORIGINS=https://tabiko.example.com

# Comma-separated emails promoted to is_admin=true on registration.
# TABIKO_ADMIN_EMAILS=you@example.com

# Shared secret for signing JWTs. MUST be set to a strong random value outside
# local development, otherwise tokens are signed with an insecure default.
# TABIKO_JWT_SECRET=

# When set, also required by admin moderation routes.
# TABIKO_API_KEY=

# --- Data ingestion ---------------------------------------------------------

# Overpass endpoint used to seed restaurants from OpenStreetMap.
# TABIKO_OVERPASS_URL=https://overpass-api.de/api/interpreter

# Identify your app to Overpass; they ask for a descriptive User-Agent.
# TABIKO_USER_AGENT=tabiko/1.0 (you@example.com)

# --- Optional: CARTO --------------------------------------------------------
#
# Not required. The frontend draws its own themed basemap from vendored
# OpenStreetMap geometry and makes no tile requests, so this is unused today.
# Only set it if CARTO-hosted styles (satellite/terrain backdrops) are added,
# and remember it must be read server-side and proxied — never exposed to the
# browser, because anything in the frontend bundle is public.
# TABIKO_CARTO_API_KEY=
