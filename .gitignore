__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.venv/
node_modules/
dist/

# The city itself is a local artifact, not source.
#
# `*.db` rather than the per-directory list this used to carry: running the app
# from the repository root leaves a tabiko.db there, and the old patterns missed
# it. A stray empty database got committed once already.
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

.env
frontend/.env.local
*.pem
*.key
id_rsa*

# Scratch files from driving the real app during verification. These held a
# live account password and a signed JWT, and were staged by accident once.
*_token.txt
e2e_*.txt
probe_*.txt
*.scratch
backups/
*.pre-restore-*

# Native build outputs. The android/ and ios/ projects themselves ARE
# committed (native config lives there); only machine-generated build
# products stay out.
frontend/android/build/
frontend/android/app/build/
frontend/android/.gradle/
frontend/android/local.properties
frontend/android/capacitor-cordova-android-plugins/
frontend/ios/build/
frontend/ios/DerivedData/
frontend/ios/App/Pods/
